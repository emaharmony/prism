# Prism Configuration — prism.yaml
#
# This is the primary configuration file for Prism.
# It defines agents, channels, actions, and service settings.
# No dependency on OpenClaw — Prism is its own system.
#
# Agent IDs become event namespace prefixes:
#   id: lumi → lumi.agent.started, lumi.tool.completed, etc.
#   If no ID is provided, auto-generated as prism1, prism2, etc.

prism:
  # Instance name used by signed cross-Prism messages.
  instance_id: "astraea-manager"
  # NATS bus URL. Empty = embedded NATS server.
  # For two-Prism mode, point both environments at the Windows broker.
  nats_url: "nats://127.0.0.1:4222"
  # Data directory for SQLite databases and run artifacts.
  data_dir: "~/.prism/data"
  # Workspace root for context injection (SOUL.md, AGENTS.md, USER.md, etc.)
  # Defaults to $HOME/.openclaw/workspace if empty.
  workspace: ""
  # Local Ollama base URL used by serve-mode Ollama agents.
  ollama_url: "http://localhost:11434"
  # Serve-mode LLM timeout in seconds. Local models often need more than 60s.
  llm_timeout_seconds: 1200
  # Log level: debug, info, warn, error
  log_level: "info"

bridge:
  # Set true after PRISM_BRIDGE_SECRET is configured on both Prism environments.
  enabled: false
  mode: "shared_nats"
  secret_env: "PRISM_BRIDGE_SECRET"
  # Optional local fallback if the env var is unavailable. Keep real secrets out of git.
  secret: ""
  # Configurable leader for cross-Prism threads. This can move between environments.
  leader_instance: "lumi-ceo"
  # Receiver-rated confidence gate. Below this, Prism asks one clarification before accepting.
  confidence_threshold: 0.75
  max_clarification_rounds: 1
  allowed_subjects:
    - "prism.cross.context_sync"
    - "prism.cross.task_request"
    - "prism.cross.status_request"
    - "prism.cross.validation_request"
    - "prism.cross.task_response"
    - "prism.cross.task_accept"
    - "prism.cross.task_reject"
    - "prism.cross.clarification"
    - "prism.cross.task_progress"
    - "prism.cross.task_result"
    - "prism.cross.task_cancel"
  target_profiles:
    - name: "generic"
      instance_id: "astraea-manager"
      adapter: "generic"
      capabilities: ["plan", "review", "report"]
    - name: "factory"
      instance_id: "astraea-manager"
      adapter: "factory"
      capabilities: ["roblox_factory", "validation", "report"]
    - name: "codex"
      instance_id: "astraea-manager"
      adapter: "codex"
      capabilities: ["code", "test", "review", "report"]
  factory:
    enabled: true
    root: "D:/_projects_/roblox-factory"
    project: "eggventura"
    project_path: "D:/Projects/Roblox/eggventura"
    approval_mode: "report_only"
    run_codex: false
    vision_review: "none"
    playtest_mode: "none"
    enable_ui_generation: false
    ui_generation_dry_run: true

codex:
  # Uses the local Codex CLI login session. Run `codex login` before enabling.
  enabled: false
  # Empty = codex.cmd on Windows, codex elsewhere.
  executable: ""
  # Empty = Codex CLI default/profile model. Set only when you want to force a model.
  model: ""
  profile: ""
  # Empty = prism.workspace, then current directory.
  workspace: ""
  sandbox: "workspace-write"
  approval_policy: "on-request"
  timeout_minutes: 30
  max_concurrency: 1
  capture_diff: true
  extra_args: []

agents:
  - id: astraea
    role: orchestrator
    provider: ollama
    model: "llama3.2"
    primary: true
    context:
      - soul
      - agents
      - user
    capabilities:
      - plan
      - route
      - review
      - validate
      - report
    state_actions:
      manager-room:
        inject: "Act as the Windows-side Prism manager. Prefer explicit status, bridge health, and Factory validation handoff."
      build-room:
        inject: "Focus on Roblox Factory coordination. Keep work report-only unless implementation is explicitly approved."
    # Keep Discord bot-to-bot listening disabled. Cross-Prism agents communicate over NATS.
    listen_to_agents: []
    # V22: Subscribe to other agents' task events
    # subscriptions:
    #   - "mango.task.completed"  # Receive Mango's results

  - id: forge
    role: coder
    provider: ollama
    model: "llama3.2"
    context:
      - agents
    capabilities:
      - code
      - test
      - report
    # V22: Subscribe to delegated tasks
    # subscriptions:
    #   - "mango.task.created"  # Receive tasks from Lumi

  # Optional API-backed model. Requires OPENAI_API_KEY and API billing.
  # ChatGPT web subscriptions and API billing are separate.
  # - id: openai-reviewer
  #   role: reviewer
  #   provider: openai_responses
  #   model: "gpt-5.1"
  #   context:
  #     - agents
  #   capabilities:
  #     - review
  #     - summarize

channels:
  - type: discord
    token: "${DISCORD_BOT_TOKEN}"
    channels:
      - "general"
      - "dev"

channel_roles:
  - id: "general"
    role: "manager-room"
    tools: "read-only"
    personality: "direct"
    context: "Coordination room for cross-Prism status, task triage, and manager-level decisions."
  - id: "dev"
    role: "build-room"
    tools: "all"
    personality: "terse"
    context: "Roblox Factory build and validation room. Prefer concrete task handoff, smoke checks, and artifact paths."

actions:
  # Save agent output to memory
  - trigger: "*.agent.output"
    action: "remembrance.gate.extract"
    enabled: true

  # Track token costs for every tool completion
  - trigger: "*.tool.completed"
    action: "prism.cost.track"
    enabled: true

  # Track LLM costs
  - trigger: "*.llm.completed"
    action: "prism.cost.track"
    enabled: true

  # Send approval requests to Discord
  - trigger: "*.approval.requested"
    action: "adapter.discord.notify"
    enabled: true

sessions:
  # How long before an idle session resets (minutes)
  idle_timeout_minutes: 30
  # Hour (0-23) when sessions reset daily
  daily_reset_hour: 4
  # Maximum messages in a session before compaction
  max_context_messages: 100
  # Compaction strategy: "truncate" (V20) or "summarize" (V21 with Remembrance)
  compaction_strategy: "truncate"

remembrance:
  enabled: false
  url: "http://localhost:18790"
  timeout_seconds: 60
